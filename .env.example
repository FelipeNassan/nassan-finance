# Banco de dados (Docker local)
DATABASE_URL="postgresql://usuario:senha@localhost:5432/fortn"

# Modo desenvolvimento: true desliga a autenticação e usa o usuário fixo 'dev-user'
# (permite testar sem credenciais). Em uso real: false. Reiniciar o dev server ao trocar.
AUTH_DISABLED=false

# Auth própria (JWT) — gere um segredo longo e aleatório (64+ caracteres hex)
JWT_SECRET=troque-por-um-segredo-aleatorio-de-64-caracteres

# Enquanto não há provedor de SMS, o código de verificação volta na resposta da API
# e o app mostra "código de teste". Com provedor real: false.
AUTH_DEV_RETORNA_CODIGO=true

# SMTP (Gmail) para envio real de e-mails de confirmação/reset.
# ATENÇÃO: o Gmail exige "senha de app" (myaccount.google.com/apppasswords),
# não a senha normal da conta. Sem SMTP configurado, os e-mails vão para o log.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=seu-email@gmail.com
SMTP_PASS=senha-de-app-de-16-caracteres
SMTP_FROM=fortn <seu-email@gmail.com>
